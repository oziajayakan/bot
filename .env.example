# ================================================
# SafeBot — Environment Variables
# Copy file ini menjadi .env.local untuk dev lokal
# atau set di Vercel Dashboard untuk production
# ================================================

# Upstash Redis (wajib)
# Dapatkan dari: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_URL.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN_HERE

# Secret untuk keamanan Vercel Cron (opsional, tapi recommended)
# Buat string random panjang, contoh: openssl rand -hex 32
CRON_SECRET=your_random_secret_here
